# mnft environment settings.
#
# The reference app loads a .env file from its working directory, so:
#   cp .env.example mnft_cad_web/.env
# then fill in what you need. Every setting below is optional; the defaults
# are shown as comments.

# --- LLM (the only thing you must set for real turns) -----------------------

# API key for your provider. The core accepts a plain string, an env var
# reference like this one, or an {Mod, fun, args} resolver for hosts that
# keep secrets elsewhere.
LLM_API_KEY=

# Provider driver passed to req_llm. "openai" means the OpenAI-compatible
# Chat Completions driver, which covers most vendors, including:
#   z.ai:        https://api.z.ai/api/paas/v4
#   DeepSeek:    https://api.deepseek.com
#   OpenRouter:  https://openrouter.ai/api/v1
#   OpenAI:      https://api.openai.com/v1
# "anthropic" uses Anthropic's native Messages API (Claude models) — leave
# LLM_BASE_URL empty so the provider's own endpoint is used. Example:
#   LLM_PROVIDER=anthropic
#   LLM_BASE_URL=
#   LLM_TEXT_MODEL=claude-sonnet-4-5-20250929
#   LLM_VISION_MODEL=claude-sonnet-4-5-20250929
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.z.ai/api/paas/v4

# Defaults are tuned on z.ai reasoning models, which think for minutes on
# datasheet-class parts. Fast non-reasoning models can use much lower
# timeouts.
# Reasoning models bill reasoning against max_tokens: DeepSeek thinking mode
# defaults to a 64K generation budget (docs: api-docs.deepseek.com) — don't
# set this below the vendor's thinking default or reasoning can exhaust it
# and return empty content.
LLM_TEXT_MODEL=glm-5.3-flash
LLM_VISION_MODEL=glm-4.6v
LLM_TIMEOUT_S=600
LLM_MAX_TOKENS=65536

# Automatic fix loop: when a build fails, the latest code + error go back to
# the model and the regenerated script runs again — up to REPAIR_MAX_ROUNDS
# rounds. A round never starts past MNFT_TURN_BUDGET_S (wall clock), so slow
# reasoning providers simply finish fewer rounds; raise the budget for them.
REPAIR_MAX_ROUNDS=3
MNFT_TURN_BUDGET_S=900

# --- engine selection -------------------------------------------------------

# Which engine builds the parts:
#   "build123d" (default) — full STEP/STL/GLB fidelity via the Python worker
#                           (OpenCascade wheels, ~1 GB).
#   "openscad"            — single 40 MB binary, mesh only (STL/GLB, no STEP).
#   "smlibpy"             — new/alpha: SMLib NURBS kernel from AWV Informatik AG
#                           (MIT); ~7 MB wheel, Python 3.10-3.14 (macOS/Linux/
#                           Windows wheels).
#                           Install: cd cad_worker && uv pip install -e ".[smlibpy]"
MNFT_ENGINE=build123d
# --- build123d engine (default) ---------------------------------------------

# Python interpreter and working directory of the guarded worker. The paths
# below work from a fresh clone of this repo (venv created with
#   cd cad_worker && uv venv --python 3.12 && uv pip install -e . pytest
# ).
CAD_WORKER_PYTHON=../cad_worker/.venv/bin/python
CAD_WORKER_CWD=../cad_worker

# Concurrent builds across all sessions. Each build can use up to 4 GiB of
# address space and 45 s of CPU, so size this to your machine.
CAD_EXEC_CONCURRENCY=2
CAD_EXEC_TIMEOUT_S=60

# Generated models land under CAD_MODELS_DIR/<owner_id>/<model_id>/.
CAD_MODELS_DIR=data/models

# --- OpenSCAD engine (optional) ---------------------------------------------

# Used when the core is configured with Mnft.Cad.Engines.OpenScad. The binary
# comes from your package manager: brew install openscad / apt install
# openscad / winget install OpenSCAD.OpenSCAD.
OPENSCAD_BIN=openscad
OPENSCAD_TIMEOUT_S=60

# --- CNC CAM (optional, build123d engine only) ------------------------------

# After a successful build123d build, a FreeCAD headless CAM job can also
# produce GRBL G-code (model.gcode) using the vendored Genmitsu toolbits in
# mnft_cad/priv/cam. Needs FreeCAD 1.1+ installed; the default points at the
# macOS bundle. Set MNFT_FREECAD_CMD to the FreeCAD binary elsewhere
# (Linux: /usr/bin/freecad; the flatpak/AppImage path also works).
MNFT_FREECAD_CMD=/Applications/FreeCAD.app/Contents/MacOS/FreeCAD
# Wall-clock budget for one CAM job (it launches FreeCAD, loads toolbit
# geometry and computes toolpaths).
MNFT_CAM_TIMEOUT_S=180

# --- references (PDF datasheet fetching) ------------------------------------

# A chat message containing a PDF URL triggers a server-side fetch stage
# before the LLM call: pages are rendered to PNG (sent to the vision model)
# and the text layer is extracted into the prompt. Needs poppler on PATH:
# brew install poppler / apt install poppler-utils. HTML and image URLs are
# ignored (plain text, as before).
PDFTOPPM_BIN=pdftoppm
PDFTOTEXT_BIN=pdftotext
REF_FETCH_TIMEOUT_S=30
REF_MAX_PAGES=3
REF_PDF_DPI=300
# python with Pillow + pymupdf for page trim and vector outline extraction
REF_PYTHON_BIN=../cad_worker/.venv/bin/python

# --- uploaded STL analysis (reverse engineering) ----------------------------

# A chat turn with an attached .stl triggers a deterministic mesh analysis
# (stats, cross-section outlines, renders) before the LLM call, so the model
# can rebuild the part as parametric code. Needs python with numpy + Pillow:
# the cad_worker venv already has both.
STL_PYTHON_BIN=../cad_worker/.venv/bin/python
STL_MAX_MB=20

# --- storage ----------------------------------------------------------------

# The default store journals every turn to MNFT_DATA_DIR/mnft_cad.jsonl and
# caches in ETS. Models live under CAD_MODELS_DIR.
MNFT_DATA_DIR=data
